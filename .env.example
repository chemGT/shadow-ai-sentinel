# API — paires tenant:clé séparées par des virgules
API_KEYS=acme-corp:dev-secret-change-me

# Alternative développement
# DEV_TENANT_ID=acme-corp
# DEV_API_KEY=dev-secret-change-me

PORT=3000
TELEMETRY_RETENTION_DAYS=90
RATE_LIMIT_POLICIES_PER_MIN=60
RATE_LIMIT_TELEMETRY_PER_MIN=120
# CORS_ORIGINS=https://intranet.example.com (vide = *)
TRUST_PROXY=false

# Clerk (portal authentication → backend JWT verification)
# Secret key from https://dashboard.clerk.com (Application → API Keys)
CLERK_SECRET_KEY=
# Optional: enforce issuer matching (e.g. https://your-app.clerk.accounts.dev)
CLERK_JWT_ISSUER=
