{
  "manifest_version": 3,
  "name": "Shadow AI Sentinel",
  "version": "1.1.0",
  "description": "Open-source prompt redactor: blocks or redacts secrets and personal data before they reach ChatGPT, Claude, Gemini… 100 % local.",
  "browser_specific_settings": {
    "gecko": {
      "id": "shadow-ai-sentinel@pilot.sentinel",
      "strict_min_version": "121.0",
      "data_collection_permissions": { "required": ["none"] }
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": ["storage"],
  "host_permissions": [
    "*://claude.ai/*",
    "*://chatgpt.com/*",
    "*://gemini.google.com/*",
    "*://chat.mistral.ai/*",
    "*://chat.deepseek.com/*",
    "*://perplexity.ai/*",
    "*://www.perplexity.ai/*",
    "*://grok.com/*",
    "*://copilot.microsoft.com/*"
  ],
  "background": {
    "scripts": ["src/extension/background/index.ts"],
    "type": "module"
  },
  "action": {
    "default_popup": "src/extension/popup/index.html",
    "default_title": "Shadow AI Sentinel",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "options_ui": {
    "page": "src/extension/options/index.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": [
        "*://claude.ai/*",
        "*://chatgpt.com/*",
        "*://gemini.google.com/*",
        "*://chat.mistral.ai/*",
        "*://chat.deepseek.com/*",
        "*://perplexity.ai/*",
        "*://www.perplexity.ai/*",
        "*://grok.com/*",
        "*://copilot.microsoft.com/*"
      ],
      "js": ["src/extension/content/index.tsx"],
      "run_at": "document_idle"
    }
  ]
}
