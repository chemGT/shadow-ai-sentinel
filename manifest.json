{
  "manifest_version": 3,
  "name": "Shadow AI Sentinel",
  "version": "0.1.0",
  "description": "DLP local pour LLM publics — pilote Claude",
  "permissions": ["storage"],
  "host_permissions": ["*://claude.ai/*"],
  "background": {
    "service_worker": "src/extension/background/index.ts",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["*://claude.ai/*"],
      "js": ["src/extension/content/index.tsx"],
      "run_at": "document_idle"
    }
  ]
}
