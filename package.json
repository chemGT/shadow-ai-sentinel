{
  "name": "shadow-ai-sentinel",
  "version": "1.0.0",
  "description": "Open-source browser DLP: blocks or redacts secrets and personal data before they reach public LLMs (ChatGPT, Claude, Gemini…). 100% local.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:firefox": "tsc --noEmit && vite build --config vite.firefox.config.ts",
    "package:firefox": "node scripts/package-firefox-xpi.mjs",
    "preview": "vite preview",
    "backend": "tsx src/backend/server.ts",
    "backend:dev": "tsx watch src/backend/server.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ci": "vitest run --coverage",
    "test:regex": "vitest run src/core",
    "test:api": "vitest run src/backend",
    "test:e2e": "npm run build && playwright test",
    "ci": "npm run test:ci && npm run build && npm run build:firefox"
  },
  "keywords": [
    "dlp",
    "browser-extension",
    "manifest-v3",
    "llm",
    "chatgpt",
    "claude",
    "gemini",
    "secrets",
    "pii",
    "privacy",
    "security"
  ],
  "author": "chemGT",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chemGT/shadow-ai-sentinel.git"
  },
  "bugs": {
    "url": "https://github.com/chemGT/shadow-ai-sentinel/issues"
  },
  "homepage": "https://github.com/chemGT/shadow-ai-sentinel#readme",
  "dependencies": {
    "@clerk/backend": "^3.7.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "drizzle-orm": "^0.45.2",
    "express": "^5.2.1",
    "mammoth": "^1.12.0",
    "pdfjs-dist": "^6.0.227",
    "postgres": "^3.4.9",
    "react": "^19.2.6",
    "react-dom": "^19.2.6"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.4.0",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4.3.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/chrome": "^0.1.42",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/supertest": "^7.2.0",
    "@vitejs/plugin-react": "^6.0.2",
    "@vitest/coverage-v8": "^4.1.6",
    "autoprefixer": "^10.5.0",
    "drizzle-kit": "^0.31.10",
    "happy-dom": "^20.9.0",
    "postcss": "^8.5.14",
    "supertest": "^7.2.2",
    "tailwindcss": "^4.3.0",
    "tsx": "^4.22.2",
    "typescript": "^6.0.3",
    "vite": "^8.0.13",
    "vitest": "^4.1.6"
  }
}
