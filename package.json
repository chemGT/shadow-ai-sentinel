{
  "name": "shadow-ai-sentinel",
  "version": "1.1.0",
  "description": "Open-source prompt redactor: a local browser DLP that blocks or redacts secrets and personal data before they reach ChatGPT, Claude, Gemini and other AI chatbots.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:firefox": "tsc --noEmit && vite build --config vite.firefox.config.ts",
    "package": "npm run build && node scripts/verify-dist.mjs && npm run build:firefox && node scripts/verify-dist-firefox.mjs && node scripts/package.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ci": "vitest run --coverage",
    "test:regex": "vitest run src/core",
    "test:e2e": "npm run build && playwright test",
    "ci": "npm run test:ci && npm run build && npm run build:firefox"
  },
  "keywords": [
    "prompt-redactor",
    "dlp",
    "browser-extension",
    "manifest-v3",
    "llm",
    "chatgpt",
    "claude",
    "gemini",
    "secrets",
    "pii",
    "privacy",
    "security",
    "redaction",
    "pii-redaction",
    "data-loss-prevention",
    "shadow-ai"
  ],
  "author": "chemGT",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chemGT/shadow-ai-sentinel.git"
  },
  "bugs": {
    "url": "https://github.com/chemGT/shadow-ai-sentinel/issues"
  },
  "homepage": "https://github.com/chemGT/shadow-ai-sentinel#readme",
  "dependencies": {
    "mammoth": "^1.13.0",
    "pdfjs-dist": "^6.4.299",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.4.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/chrome": "^0.3.7",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "5.0.5",
    "autoprefixer": "^10.6.2",
    "happy-dom": "^21.0.4",
    "postcss": "^8.5.32",
    "tailwindcss": "^4.3.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.5",
    "vitest": "5.0.5"
  }
}
